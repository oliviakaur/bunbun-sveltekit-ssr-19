# Backend API origin (no trailing slash)
PUBLIC_API_BASE=https://bunbunserver.my.id

# Optional fixed site title. Leave blank to auto-derive from each request hostname
# (e.g., example-auto.com -> "Example Auto").
PUBLIC_SITE_TITLE=

# External or local JS loader for the human-only sticky bottom ad (320x50 mobile / 300x250 desktop).
# Defaults to /ad.js (served from static/ad.js). Point to an external URL (e.g., https://bunbunserver.my.id/ad.js)
# to rotate ad domains across all sites without redeploying.
PUBLIC_AD_SCRIPT_URL=/ad.js

# Build adapter selector: node | vercel | cloudflare | netlify
# Auto-detected on Vercel, Netlify, and Cloudflare; defaults to node for Docker/Render/Azure/Dokploy.
ADAPTER=node

# Multi-domain reverse proxy headers for @sveltejs/adapter-node (Render, Azure App Service, Dokploy)
# Do NOT hardcode ORIGIN if one instance serves multiple custom domains.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
PORT=3000
